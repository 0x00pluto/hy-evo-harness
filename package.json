{
  "name": "huyuan-hub",
  "version": "0.1.0",
  "private": true,
  "description": "Huyuan AI 统一工作台 Hub",
  "type": "module",
  "main": "dist/main/index.js",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.26.2",
  "scripts": {
    "preinstall": "node -e \"if(!/pnpm/.test(process.env.npm_execpath||'')){console.error('请使用 pnpm 安装依赖');process.exit(1)}\"",
    "build": "tsc",
    "start": "tsc && electron .",
    "test": "node --experimental-strip-types --test test/*.test.ts"
  },
  "dependencies": {
    "electron": "^44.7.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "typescript": "^7.0.2"
  }
}
