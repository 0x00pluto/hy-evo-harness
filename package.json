{
  "name": "dex-buddy",
  "version": "0.16.0",
  "private": true,
  "description": "Dex Buddy",
  "type": "module",
  "main": "dist/main/index.js",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.26.2",
  "scripts": {
    "preinstall": "node -e \"if(!/pnpm/.test(process.env.npm_execpath||'')){console.error('请使用 pnpm 安装依赖');process.exit(1)}\"",
    "build": "tsc && tsc -p tsconfig.renderer.json --noEmit",
    "start": "tsc && electron .",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "build:unpack": "tsc && tsc -p tsconfig.renderer.json --noEmit && electron-builder --dir",
    "build:win": "tsc && tsc -p tsconfig.renderer.json --noEmit && electron-builder --win",
    "build:mac": "tsc && tsc -p tsconfig.renderer.json --noEmit && electron-builder --mac",
    "build:linux": "tsc && tsc -p tsconfig.renderer.json --noEmit && electron-builder --linux"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "lottie-web": "^5.13.0",
    "lucide": "^1.53.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "typescript": "^7.0.2"
  }
}
